# =====================================================
#  SOC Infrastructure Lab — variables de entorno
#  Copiar como `.env` y personalizar antes de docker compose up
# =====================================================

# --- Splunk ---
SPLUNK_PASSWORD=ChangeMe-Splunk-Str0ng!
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000

# --- TheHive / Cortex ---
# Generar con: openssl rand -base64 64
THEHIVE_SECRET=change-me-thehive-secret-64-chars-min
# Se obtiene la primera vez desde la UI de Cortex
CORTEX_API_KEY=REPLACE_AFTER_FIRST_LOGIN

# --- MISP ---
MISP_MYSQL_ROOT_PASSWORD=ChangeMe-Root-MISP!
MISP_MYSQL_PASSWORD=ChangeMe-Misp-User!
MISP_ADMIN_EMAIL=admin@soc.lab
MISP_ADMIN_PASSWORD=ChangeMe-MISP-Admin!
# 40 chars alfanuméricos
MISP_ADMIN_KEY=REPLACE_WITH_40_CHAR_RANDOM_STRING_XXXXXX

# --- Red / laboratorio ---
LAB_DOMAIN=soc.lab
TIMEZONE=America/Bogota
